# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Postgres ---
POSTGRES_USER=elal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elal_ops

# Composed for services that need it directly.
DATABASE_URL=postgres://elal:change-me@postgres:5432/elal_ops

# --- OpenAI ---
# Used by the RAG service for embeddings and by Langflow if you point an agent
# at an OpenAI-compatible model. Leave blank to keep /search returning 503.
OPENAI_API_KEY=

# --- Vapi webhook ---
# Shared secret; the assistant is configured to send it in X-Webhook-Secret.
WEBHOOK_SECRET=change-me
